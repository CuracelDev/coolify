APP_ID=coolify-staging
APP_NAME=Coolify Staging
APP_ENV=staging
APP_KEY=
APP_URL=http://YOUR_VM_HOST_OR_IP:8001
APP_PORT=8001
APP_DEBUG=false
SELF_HOSTED=true

DB_CONNECTION=pgsql
DB_HOST=coolify-staging-db
DB_PORT=5432
DB_DATABASE=coolify_staging
DB_USERNAME=coolify
DB_PASSWORD=change-me

REDIS_HOST=coolify-staging-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

PUSHER_APP_ID=coolify-staging
PUSHER_APP_KEY=coolify-staging
PUSHER_APP_SECRET=change-me
PUSHER_HOST=YOUR_VM_HOST_OR_IP
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_BACKEND_HOST=coolify-staging-realtime
PUSHER_BACKEND_PORT=6001

SOKETI_HOST=0.0.0.0
SOKETI_PORT=6001
SOKETI_METRICS_PORT=6002
SOKETI_DEBUG=false

ROOT_USERNAME=Root User
ROOT_USER_EMAIL=root@example.com
ROOT_USER_PASSWORD=change-me-now

REGISTRY_URL=ghcr.io

# Set these when serving staging behind a real hostname/reverse proxy.
# SESSION_COOKIE=coolify_staging_session
# SESSION_DOMAIN=staging.example.com
